{
	"name": "datastory",
	"version": "1.0.0",
	"private": true,
	"description": "DataStory - turn any spreadsheet into a story. Browser-only data-to-dashboard app.",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"probe": "vitest run --config probes/vitest.probe.config.ts probes/e2e.probe.ts",
		"probe:live": "vitest run --config probes/vitest.probe.config.ts probes/live.probe.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/papaparse": "5.3.16",
		"axe-core": "4.14.0",
		"playwright": "1.64.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@e965/xlsx": "0.20.3",
		"@fontsource-variable/inter": "5.2.8",
		"echarts": "6.1.0",
		"papaparse": "5.7.0",
		"pdf-lib": "1.17.1"
	}
}
