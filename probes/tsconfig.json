{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"paths": {
			"#lib/*": ["../src/lib/*"]
		}
	},
	"include": ["**/*.ts"]
}
